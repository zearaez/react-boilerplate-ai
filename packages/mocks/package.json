{
  "name": "@repo/mocks",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "MSW handlers, fixtures and a standalone mock API server",
  "//": "Imports NOTHING from @repo/core. It is an independent fake backend; the contract is verified by a test in core that parses these responses against core's zod schemas.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./handlers": "./src/handlers/index.ts"
  },
  "scripts": {
    "server": "tsx watch src/server.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mswjs/http-middleware": "catalog:",
    "express": "catalog:",
    "msw": "catalog:"
  },
  "devDependencies": {
    "@repo/config": "workspace:*",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
