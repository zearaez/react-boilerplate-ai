# ============================================================================
# Copy to .env and fill in. NEVER commit .env — .gitignore covers it.
# Every variable here must also appear in docs/env-vars.md, and web vars must be
# declared in apps/web/src/vite-env.d.ts or they are `any` at the call site.
#
# There are NO real secrets in this file and there must never be. Anything
# prefixed VITE_ or EXPO_PUBLIC_ is inlined into a shippable bundle and is
# readable by anyone who has the app.
# ============================================================================

# ---------------------------------------------------------------------------
# Web (apps/web) — Vite only exposes variables prefixed VITE_
# ---------------------------------------------------------------------------

# Base URL of the API. Ignored while VITE_ENABLE_MOCKS=true.
VITE_API_URL=http://localhost:4000

# 'true' runs the app entirely against the MSW handlers in @repo/mocks, so a
# fresh clone works with no backend. Set 'false' to talk to VITE_API_URL.
VITE_ENABLE_MOCKS=true

# Error tracking. Leave empty to disable Sentry completely (no init, no network).
VITE_SENTRY_DSN=

# development | uat | production — tags Sentry events.
VITE_APP_ENV=development

# ---------------------------------------------------------------------------
# Mobile (apps/mobile) — Expo only exposes variables prefixed EXPO_PUBLIC_
# ---------------------------------------------------------------------------

# Usually leave this UNSET. apps/mobile/lib/api-url.ts derives your machine's LAN
# address from the Expo dev server, which is what makes the mock API reachable
# from a physical device without editing an IP by hand. Set it only for a real
# backend or a tunnel.
# EXPO_PUBLIC_API_URL=https://api.example.com

EXPO_PUBLIC_SENTRY_DSN=

# development | uat | production — also selects the app name and bundle id
# suffix in apps/mobile/app.config.ts.
APP_ENV=development

# ---------------------------------------------------------------------------
# Local mock API (packages/mocks)
# ---------------------------------------------------------------------------

# Port for `pnpm mock`. Keep in sync with MOCK_PORT in apps/mobile/lib/api-url.ts.
MOCK_PORT=4000

# Enable the bug reporter. The bug reporter is a small floating button that
# opens a form to submit a bug report. It is only available in development mode.
VITE_BUG_REPORTER_ENABLED=true

# Enable the bug reporter in Expo. The bug reporter is a small floating button that
# opens a form to submit a bug report. It is only available in development mode.
EXPO_PUBLIC_BUG_REPORTER_ENABLED=true
