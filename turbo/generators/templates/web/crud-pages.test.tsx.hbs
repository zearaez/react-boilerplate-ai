describe('{{pascalCase name}}CreatePage', () => {
  it('blocks an invalid submit without navigating', async () => {
    const user = userEvent.setup();
    const { router } = renderRoute({
      path: '/{{plural}}/new',
      element: <{{pascalCase name}}CreatePage />,
      initialEntry: '/{{plural}}/new',
    });

    await user.type(screen.getByLabelText('Title'), 'no');
    await user.click(screen.getByRole('button', { name: /create/i }));

    // The message comes from create{{pascalCase name}}InputSchema in @repo/core.
    expect(await screen.findByText(/at least 3 characters/i)).toBeInTheDocument();
    expect(router.state.location.pathname).toBe('/{{plural}}/new');
  });

  it('creates and navigates to the new record', async () => {
    const user = userEvent.setup();
    const { router } = renderRoute({
      path: '/{{plural}}/new',
      element: <{{pascalCase name}}CreatePage />,
      initialEntry: '/{{plural}}/new',
      extraRoutes: [{ path: '/{{plural}}/:id', element: null }],
    });

    await user.type(screen.getByLabelText('Title'), 'A valid new title');
    await user.click(screen.getByRole('button', { name: /create/i }));

    await waitFor(() => {
      expect(router.state.location.pathname).toMatch(/^\/{{plural}}\/.+/);
    });
  });
});

describe('{{pascalCase name}}EditPage', () => {
  it('prefills from the loaded record', async () => {
    renderRoute({
      path: '/{{plural}}/:id/edit',
      element: <{{pascalCase name}}EditPage />,
      initialEntry: `/{{plural}}/${SEEDED_ID}/edit`,
    });

    await waitFor(() => {
      expect(screen.getByLabelText<HTMLInputElement>('Title').value.length).toBeGreaterThan(0);
    });
  });

  it('saves and returns to the detail route', async () => {
    const user = userEvent.setup();
    const { router } = renderRoute({
      path: '/{{plural}}/:id/edit',
      element: <{{pascalCase name}}EditPage />,
      initialEntry: `/{{plural}}/${SEEDED_ID}/edit`,
      extraRoutes: [{ path: '/{{plural}}/:id', element: null }],
    });

    const title = await screen.findByLabelText('Title');
    await user.clear(title);
    await user.type(title, 'An edited title');
    await user.click(screen.getByRole('button', { name: /save/i }));

    await waitFor(() => {
      expect(router.state.location.pathname).toBe(`/{{plural}}/${SEEDED_ID}`);
    });
  });
});
