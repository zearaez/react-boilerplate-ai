describe('{{pascalCase name}}DetailPage', () => {
  it('renders the record at the route param', async () => {
    renderRoute({
      path: '/{{plural}}/:id',
      element: <{{pascalCase name}}DetailPage />,
      initialEntry: `/{{plural}}/${SEEDED_ID}`,
    });

    expect(await screen.findByRole('heading', { level: 1 })).toBeInTheDocument();
  });

  it('shows a not-found message for a missing id rather than crashing', async () => {
    renderRoute({
      path: '/{{plural}}/:id',
      element: <{{pascalCase name}}DetailPage />,
      initialEntry: '/{{plural}}/does-not-exist',
    });

    expect(await screen.findByRole('alert')).toBeInTheDocument();
