import { HttpResponse, http } from 'msw';

import { registerReset, userFromAuthHeader } from '../db';
import { type Mock{{pascalCase name}}, initial{{pascalCase plural}} } from '../fixtures/{{plural}}';

/**
 * GENERATED by `pnpm gen feature`.
 *
 * EVERY path starts with `*`. The browser worker matches absolute URLs while
 * @mswjs/http-middleware matches bare paths; the leading `*` is the only form
 * that satisfies both. Drop it and mocks work on web but 404 on device.
 */
const DEFAULT_PAGE_SIZE = 10;

// Module-local store so this feature's handlers are self-contained. Move it into
// db.ts if another handler needs to read it.
let records: Mock{{pascalCase name}}[] = initial{{pascalCase plural}}.map((record) => ({ ...record }));

export function reset{{pascalCase plural}}(): void {
  records = initial{{pascalCase plural}}.map((record) => ({ ...record }));
}

// Hooks this feature into resetDb() so its records are restored between tests.
// Without this, one test deleting a record breaks a later, unrelated test.
registerReset(reset{{pascalCase plural}});

function unauthorized() {
  return HttpResponse.json({ message: 'Not authenticated.' }, { status: 401 });
}

export const {{camelCase plural}}Handlers = [
  http.get('*{{apiPath}}', ({ request }) => {
    if (!userFromAuthHeader(request.headers.get('Authorization'))) return unauthorized();

    const url = new URL(request.url);
    const page = Math.max(1, Number(url.searchParams.get('page') ?? 1));
    const pageSize = Math.min(Number(url.searchParams.get('pageSize') ?? DEFAULT_PAGE_SIZE), 100);
    const search = url.searchParams.get('search')?.toLowerCase().trim() ?? '';

    const matching = search
      ? records.filter((record) => record.title.toLowerCase().includes(search))
      : records;

    const start = (page - 1) * pageSize;
    const items = matching.slice(start, start + pageSize);

    return HttpResponse.json({
      items,
      page,
      pageSize,
      total: matching.length,
      hasMore: start + items.length < matching.length,
    });
  }),

  http.get('*{{apiPath}}/:id', ({ request, params }) => {
    if (!userFromAuthHeader(request.headers.get('Authorization'))) return unauthorized();

    const record = records.find((candidate) => candidate.id === params.id);
    if (!record) return HttpResponse.json({ message: 'Not found.' }, { status: 404 });

    return HttpResponse.json(record);
  }),

  http.post('*{{apiPath}}', async ({ request }) => {
    if (!userFromAuthHeader(request.headers.get('Authorization'))) return unauthorized();

    const body = (await request.json()) as { title?: unknown };
    const title = typeof body.title === 'string' ? body.title.trim() : '';

    if (title.length < 3) {
      return HttpResponse.json(
        { message: 'Validation failed.', errors: { title: ['Title must be at least 3 characters.'] } },
        { status: 422 },
      );
    }

    const created: Mock{{pascalCase name}} = {
      id: `{{name}}-${String(Date.now())}`,
      title,
      createdAt: new Date().toISOString(),
    };
    records.unshift(created);

    return HttpResponse.json(created, { status: 201 });
  }),

  http.patch('*{{apiPath}}/:id', async ({ request, params }) => {
    if (!userFromAuthHeader(request.headers.get('Authorization'))) return unauthorized();

    const index = records.findIndex((candidate) => candidate.id === params.id);
    const existing = records[index];
    if (index === -1 || !existing) {
      return HttpResponse.json({ message: 'Not found.' }, { status: 404 });
    }

    const body = (await request.json()) as { title?: unknown };
    const updated: Mock{{pascalCase name}} = {
      ...existing,
      ...(typeof body.title === 'string' ? { title: body.title.trim() } : {}),
    };
    records[index] = updated;

    return HttpResponse.json(updated);
  }),

  http.delete('*{{apiPath}}/:id', ({ request, params }) => {
    if (!userFromAuthHeader(request.headers.get('Authorization'))) return unauthorized();

    const index = records.findIndex((candidate) => candidate.id === params.id);
    if (index === -1) return HttpResponse.json({ message: 'Not found.' }, { status: 404 });

    records.splice(index, 1);
    return new HttpResponse(null, { status: 204 });
  }),
];
