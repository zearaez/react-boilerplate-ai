    "dev": "expo start --dev-client",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --clean",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "//doctor": "expo-doctor is NOT a local bin in SDK 57 \u2014 it is a separate package, so it must be run through dlx/npx.",
    "doctor": "pnpm dlx expo-doctor@latest",
    "deps:check": "expo install --check",
    "export": "expo export --platform all --output-dir dist"
