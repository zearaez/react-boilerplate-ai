# nodeLinker lives in pnpm-workspace.yaml (pnpm 10+ moved it there) — not here.

# Audit 5.2: every dependency version is pinned or bounded deliberately.
save-exact=true

# The workspace deliberately runs some libraries outside their declared peer
# ranges (jest-expo@57 peers @react-native/jest-preset ^0.85 against RN 0.86 —
# expo/expo#47435, handled by pnpm.overrides). Failing the install on that is
# noise, so peers are checked by `pnpm doctor` / CI instead.
strict-peer-dependencies=false

# Expo's CLI and Metro read these through the environment during EAS builds.
public-hoist-pattern[]=*expo*
public-hoist-pattern[]=*babel*
public-hoist-pattern[]=tailwindcss
