{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm add:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm format:*)",
      "Bash(pnpm quality:check)",
      "Bash(pnpm tokens:sync)",
      "Bash(pnpm gen:*)",
      "Bash(pnpm doctor)",
      "Bash(pnpm --filter:*)",
      "Bash(pnpm exec:*)",
      "Bash(pnpm dlx expo-doctor:*)",
      "Bash(make:*)",
      "Bash(node scripts/:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git switch -c:*)",
      "Bash(git add:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "WebFetch(domain:docs.expo.dev)",
      "WebFetch(domain:reactrouter.com)",
      "WebFetch(domain:vite.dev)",
      "WebFetch(domain:vitest.dev)",
      "WebFetch(domain:eslint.org)",
      "WebFetch(domain:v3.tailwindcss.com)",
      "WebFetch(domain:www.nativewind.dev)",
      "WebFetch(domain:tanstack.com)",
      "WebFetch(domain:ui.shadcn.com)",
      "WebFetch(domain:zod.dev)",
      "WebFetch(domain:react.dev)",
      "WebFetch(domain:typescript-eslint.io)",
      "WebFetch(domain:callstack.github.io)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.p8)",
      "Read(./**/*.p12)",
      "Read(./**/*.keystore)",
      "Read(./**/google-services.json)",
      "Read(./**/GoogleService-Info.plist)",
      "Bash(git push:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git reset --hard:*)",
      "Bash(eas build:*)",
      "Bash(eas submit:*)",
      "Bash(eas update:*)",
      "Bash(vercel:*)",
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(yarn:*)",
      "Bash(rm -rf:*)"
    ]
  }
}
